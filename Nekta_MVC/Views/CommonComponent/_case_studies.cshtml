@using Nekta_BusinessLogic.Entity
@using Nekta_MVC.Helpers
@using Nekta_MVC.Models

@model CaseStudiesViewModel

@{
    var component = Model.Case_Studies_Component_List.FirstOrDefault(x => x.IsBlock == 0);
}

<section class="section-spacing relative overflow-hidden">
    <img src="/Assets/images/bg-pattern.webp" alt="" class="w-full h-full absolute top-0 left-0" />

    <div class="container">

        <!-- Section Heading -->
        <div class="section-title-outer text-center max-w-6xl mx-auto">

            <h2 class="title-section text text-h2" data-leaf-target letters-sli de-down text-split>
                @Html.Raw(
                !string.IsNullOrWhiteSpace(component.DisplayTitle)
                ? component.DisplayTitle.CleanParagraphTags()
                : component.Title)
            </h2>

            <p>
                @Html.Raw(component?.Intro.CleanParagraphTags())
            </p>

        </div>

        <!-- Swiper -->
        <div class="swiper insightsSwiper px-2 md:px-4 blogs-cards-slider">

            <div class="swiper-wrapper">

                @if (Model.Case_Studies_List != null && Model.Case_Studies_List.Any())
                {
                    foreach (var item in Model.Case_Studies_List)
                    {
                        <div class="swiper-slide h-auto">
                            <div class="insight-card group blogs-cards-wrapper">
                                <div class="media-frame overflow-hidden rounded-lg ratio-[531/315] blogs-cards-image">
                                    <img loading="lazy" src="@item.ThumbnailImage" alt="@item.ThumbnailAltText"
                                        class="w-full object-cover" />
                                </div>
                                <div class="py-6 blogs-cards-content">
                                    <span
                                        class="pill inline-block bg-green text-cream text-xs font-medium px-2.5 py-1 rounded-lg">
                                        Case Study
                                    </span>

                                    <h3 class="insight-title line-clamp-2">
                                        @item.Title
                                    </h3>

                                    @if (!string.IsNullOrWhiteSpace(item.Url))
                                    {
                                        <a href="@item.Url" class="link-md link-primary mt-4">
                                            <span class="underline">Read More</span>
                                            <img loading="lazy" src="/Assets/images/arrows/orangearrow-long-right.png"
                                                alt="rightArrow" />
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>
            <div class="blogs-slider-nav">
                <button class="blogs-prev" aria-label="Previous">
                    <img src="/Assets/images/arrows/swiperLeft.png" alt="">
                </button>

                <button class="blogs-next" aria-label="Next">
                    <img src="/Assets/images/arrows/swiperRight.png" alt="">
                </button>
            </div>
        </div>

        <!-- View All -->
        <div class="flex justify-center mt-6">
            @if (!string.IsNullOrWhiteSpace(component?.Url))
            {
                <a href="@component.Url" class="common-btn flex items-center gap-2 btn-slide-fill">
                    <span>
                        @(string.IsNullOrWhiteSpace(component.Url_Text)
                                            ? "View All Case Study"
                                            : component.Url_Text)
                    </span>
                    <img loading="lazy" src="/Assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                </a>
            }
        </div>

    </div>

</section>