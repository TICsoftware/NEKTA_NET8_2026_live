@using Nekta_BusinessLogic.Entity
@using Nekta_MVC.Helpers
@model List<ComponentModel>

@{
    var component = Model.FirstOrDefault(x => x.IsBlock == 0);
}

@if (component != null)
{
    <!-- ==================== FOLLOW NEKTA ==================== -->
    <section class="cu-follow-section section-spacing">
        <div class="container text-center">
            <!-- Section Heading -->
            <div class="section-title-outer text-center mx-auto max-w-7xl ">
                <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                    @Html.Raw(
                    !string.IsNullOrWhiteSpace(component.DisplayTitle)
                    ? component.DisplayTitle.CleanParagraphTags()
                    : component.Title)
                </h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(component.Intro))
            {
                <p>@Html.Raw(component.Intro.CleanParagraphTags())</p>
            }
            <div class="flex items-center justify-center gap-4">
                <a href="https://www.facebook.com/" target="_blank" rel="noopener" class="cu-social-circle" aria-label="Facebook">
                    <svg class="fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14.5 8.5V6.75c0-.5.42-.75.92-.75H17V3.2A20 20 0 0 0 14.66 3c-2.32 0-3.91 1.42-3.91 4.02V8.5H8.13v3.13h2.62V21h3.21v-9.37h2.51l.4-3.13z" />
                    </svg>
                </a>
                <a href="https://www.instagram.com/" target="_blank" rel="noopener" class="cu-social-circle" aria-label="Instagram">
                    <svg class="fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7.6 2.75h8.8A4.86 4.86 0 0 1 21.25 7.6v8.8a4.86 4.86 0 0 1-4.85 4.85H7.6a4.86 4.86 0 0 1-4.85-4.85V7.6A4.86 4.86 0 0 1 7.6 2.75m0 1.75A3.1 3.1 0 0 0 4.5 7.6v8.8a3.1 3.1 0 0 0 3.1 3.1h8.8a3.1 3.1 0 0 0 3.1-3.1V7.6a3.1 3.1 0 0 0-3.1-3.1zm8.98 1.44a1.16 1.16 0 1 1 0 2.32 1.16 1.16 0 0 1 0-2.32M12 7.25A4.75 4.75 0 1 1 12 16.75 4.75 4.75 0 0 1 12 7.25m0 1.75a3 3 0 1 0 0 6 3 3 0 0 0 0-6" />
                    </svg>
                </a>
                <a href="https://www.linkedin.com/" target="_blank" rel="noopener" class="cu-social-circle" aria-label="LinkedIn">
                    <svg class="fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6.94 8.75H3.75V21h3.19zM5.35 3a1.85 1.85 0 1 0 0 3.7 1.85 1.85 0 0 0 0-3.7m5.6 5.75H7.9V21h3.19v-6.44c0-1.7.32-3.35 2.43-3.35 2.08 0 2.1 1.94 2.1 3.46V21h3.19v-7.14c0-3.5-.75-6.2-4.85-6.2a4.24 4.24 0 0 0-3.82 2.1h-.04z" />
                    </svg>
                </a>
            </div>
        </div>
    </section>
}
