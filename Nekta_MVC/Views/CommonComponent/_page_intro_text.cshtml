@using Nekta_BusinessLogic.Entity
@using Nekta_MVC.Helpers
@model ContentViewModel

@if (Model != null && !string.IsNullOrWhiteSpace(Model.Cont_intro))
{
    <section class="section-spacing">
        <div class="container">
            <div class="max-w-5xl mx-auto text-center intro-section-wrap">
                @Html.Raw(Model.Cont_intro)
            </div>
        </div>
    </section>
}
