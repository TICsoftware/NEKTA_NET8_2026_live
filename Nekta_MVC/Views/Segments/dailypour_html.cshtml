<!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="/Assets/images/banners/daily_pour_banner.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="Assets/images/banners/daily_pour_banner.webp">

                  <!-- Mobile -->
                  <img
                     src="Assets/images/banners/daily_pour_banner.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-4xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 About Us
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                        
                           <span class="innerbanner-title-span">
                              The Daily Pour
                           </span>
                        </h1>

                        <p class="innerbanner-desc text-white/80">
                           Creating an everyday habit</p>
                        <a href="/contact-us" class="common-btn  btn-slide-fill" type="button" data-modal-open="contactModal">
                            <span>Explore</span>
                            <img loading="lazy" src="/Assets/images/arrows/creamarrow-long-right.png" alt="rightArrow">
                        </a>

                     </div>
                  </div>

               </div>
           

         </div>
      </section>
<!-- HERO BANNER END -->

<!-- CRAFTS WORKDAY-->
<section class="home-daily-pour-section daily-pour-section section-spacing">

  <img
    src="/Assets/images/dailypour/bg-texture-cream.webp"
    alt=""
    class="dp-bg-texture"
  />

  <img
    src="/Assets/images/dailypour/deco-coffee-pour-left.png"
    alt=""
    class="dp-deco dp-deco-left"
  />

  <img
    src="/Assets/images/dailypour/deco-coffee-cup-right.png"
    alt=""
    class="dp-deco dp-deco-right"
  />

  <div class="dp-inner">

    

  
    <div class="dp-heading-wrap">
            <h2 class="title-section-red  " data-leaf-target letters-slide-down text-split>
            <span
            class="title-section  text-letters-slide"
            >Where Craft Meets the Workday</span
            >
        </h2>
        <div class="dp-divider" aria-hidden="true"></div>
    </div>
      
    </div>

    <div class="dp-content-grid">

      <div class="dp-image-wrap">
        <img
          src="/Assets/images/dailypour/pour-arch.png"
          alt="Barista pouring coffee into a French press"
          class="dp-arch-image"
        />
      </div>

      <div class="dp-text-block">
        <p>
          The Daily Pour is Nekta's premium beverage and bakery concept, designed
          for the spaces where modern professionals spend their day. Built
          around speciality coffees, artisanal teas and a curated bakery, it
          brings a moment of craft to the workplace, the campus, the hospital
          lobby, the hotel lounge and anywhere a thoughtful break belongs.
        </p>
                <p>
          The Daily Pour is Nekta's premium beverage and bakery concept, designed
          for the spaces where modern professionals spend their day. Built
          around speciality coffees, artisanal teas and a curated bakery, it
          brings a moment of craft to the workplace, the campus, the hospital
          lobby, the hotel lounge and anywhere a thoughtful break belongs.
        </p>
        <p class="dp-fade" id="dpFadeParagraph">
          Operated on a flexible kiosk model, The Daily Pour fits beautifully
          into corporate floors, hospitality venues, healthcare campuses and
          event spaces without the complexity, footprint or cost of a full
          cafe build-out. Each kiosk is staffed by trained baristas, anchored
          by a thoughtfully developed menu and operated to the same
          <span id="dpMoreText"> exacting standard of quality and hospitality across every location, no matter the scale of the space.</span>
        </p>
        <button type="button" class="dp-read-more" id="dpReadMoreBtn" aria-expanded="false" aria-controls="dpFadeParagraph">
          <span id="dpReadMoreLabel">Read More</span> <span class="dp-plus">+</span>
        </button>
      </div>

    </div>

  </div>

</section>


<!-- PRECISION IN EVERY CUP -->
<section class="daily-pour-quote-banner dpq-banner">

  <div class="dpq-deco dpq-deco-left">
