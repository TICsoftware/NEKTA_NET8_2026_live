    <img class="backbone-cell-c" src="/Assets/images/dailypour/collage-03.png" alt="" />
    <img class="backbone-cell-d is-leaf is-leaf-right-top" src="/Assets/images/dailypour/collage-01.jpg" alt="" />
    <img class="backbone-cell-e is-leaf is-leaf-right-top" src="/Assets/images/dailypour/collage-01.jpg" alt="" />
